# Copy to .env.local, then supply NEW credentials. Never use credentials from the archive.
# The frontend has no credentials and calls /api on the same origin.
CATALOGUE_SOURCE=snapshot
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
# Production: CATALOGUE_SOURCE=supabase and NODE_ENV=production
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Only for maintenance CLI / protected CI. Never configure on the web deployment.
SUPABASE_IMPORT_SECRET_KEY=
# Distributed API quota (Upstash-compatible Redis REST). Required in production.
RATE_LIMIT_URL=
RATE_LIMIT_TOKEN=
# Optional: comma-separated exact HTTPS frontend origins for separate hosting.
ALLOWED_ORIGINS=
# Account service: use an isolated project or confirm old elevated keys are revoked first.
# Keep disabled until the profile schema, email OTP/SMTP and shared account quota are verified.
ACCOUNT_AUTH_READY=false
ACCOUNT_SUPABASE_URL=
ACCOUNT_SUPABASE_PUBLISHABLE_KEY=
